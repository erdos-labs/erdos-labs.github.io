---
const { size = 32 } = Astro.props;
---
<svg viewBox="0 0 280 210" width={size} height={size * 0.75} role="img" aria-label="erdos" class="logo">
  <g fill="none" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
    <path stroke="var(--logo-a)" d="M 42,126 C 58,63 82,14 111,20 C 139,26 151,91 177,139 C 187,162 205,154 219,136.1" />
    <path stroke="var(--logo-b)" d="M 57,145 C 76,181 98,177 120,143 C 145,103 164,47 190,60 C 211,70 226,111 241,126" />
  </g>
  <circle fill="var(--logo-a)" cx="42" cy="126" r="15" />
  <circle fill="var(--logo-b)" cx="241" cy="126" r="15" />
</svg>
